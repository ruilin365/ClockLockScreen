@* Windows 11 风格开关：40×20 胶囊轨道 + 12px 圆点，可带文字标签 *@
<div class="win-switch-row @(Disabled ? "win-switch-disabled" : "")">
    <button type="button"
            class="win-switch @(Value ? "win-switch-on" : "")"
            role="switch"
            aria-checked="@(Value ? "true" : "false")"
            disabled="@Disabled"
            @onclick="OnClick">
        <span class="win-switch-knob"></span>
    </button>

    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="win-switch-label" @onclick="OnClick">@Label</span>
    }
</div>

@code {

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task OnClick()
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }
        return ValueChanged.InvokeAsync(!Value);
    }
}
