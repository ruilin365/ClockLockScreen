<UserControl x:Class="ComputerLock.Controls.LockSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ComputerLock.Controls"
             IsHitTestVisible="False"
             Focusable="False">

    <Grid>
        <!--
            模糊层：屏幕取景的模糊图，铺满整屏。整个画面的最底层。
        -->
        <Image x:Name="BlurLayer"
               Stretch="Fill"
               Visibility="Collapsed"
               IsHitTestVisible="False" />

        <!--
            全屏遮罩：铺满整屏的一层颜色，可以是任意纯色或渐变。
            纯色时直接用 Background，渐变时 Background 铺底色、MeshCanvas 叠柔和色块。
        -->
        <Grid x:Name="MaskLayer"
              Visibility="Collapsed"
              ClipToBounds="True"
              IsHitTestVisible="False">
            <Canvas x:Name="MeshCanvas" />
        </Grid>

        <!--
            时钟层：只剩翻页时钟本身，不带任何背景。
            解锁时密码框出现，这一层会整体压暗。
        -->
        <Grid x:Name="ClockLayer"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Viewbox x:Name="ClockHost"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed"
                     IsHitTestVisible="False">
                <controls:FlipClock x:Name="LockClock" />
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>
